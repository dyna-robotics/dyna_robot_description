def "Studio"
{
    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Studio/FloorMaterial>
        double size = 1
        float3 xformOp:scale = (200, 200, 0.1)
        double3 xformOp:translate = (0, 0, -0.055)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "FloorMaterial"
    {
        token outputs:surface.connect = </Studio/FloorMaterial/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.22, 0.25, 0.29)
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }

    def RectLight "Fill"
    {
        float inputs:height = 3
        float inputs:intensity = 3200
        float inputs:width = 3
        matrix4d xformOp:transform = ( (-0.8320502943378438, 0.5547001962252291, -2.7755575615628914e-17, 0), (-0.28892397106425144, -0.43338595659637713, 0.8536390054171065, 0), (0.4735137238103783, 0.7102705857155676, 0.5208650961914162, -0), (2, 3.0000000000000004, 3, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def RectLight "Key"
    {
        float inputs:height = 3
        float inputs:intensity = 4800
        float inputs:width = 3
        matrix4d xformOp:transform = ( (0.7071067811865476, 0.7071067811865476, 0, 0), (-0.42579703632987964, 0.42579703632987964, 0.7983694431185243, -0), (0.5645324471212361, -0.5645324471212361, 0.6021679435959851, 0), (2.9999999999999996, -2.9999999999999996, 3.9999999999999996, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def RectLight "Rim"
    {
        float inputs:height = 3
        float inputs:intensity = 3600
        float inputs:width = 3
        matrix4d xformOp:transform = ( (0, -1, 0, 0), (0.7399400733959438, 0, 0.6726727939963125, 0), (-0.6726727939963125, 0, 0.7399400733959438, 0), (-2, -0, 3, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def Camera "Camera"
    {
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 36
        matrix4d xformOp:transform
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

